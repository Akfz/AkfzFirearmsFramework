{
    "version": 8,
    "configurePresets": [
        {
            "name": "linux-debug",
            "displayName": "Linux Debug (Clang)",
            "description": "Debug build for Linux using Clang",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release (Clang)",
            "description": "Optimized release build for Linux",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "linux-gcc-release",
            "displayName": "Linux Release (GCC)",
            "description": "Optimized release build for Linux using GCC",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-debug-build",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release-build",
            "configurePreset": "linux-release"
        },
        {
            "name": "linux-gcc-release-build",
            "configurePreset": "linux-gcc-release"
        }
    ]
}
